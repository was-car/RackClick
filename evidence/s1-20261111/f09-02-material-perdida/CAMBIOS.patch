+        {bad.Parameters.AddWithValue("house",house);bad.Parameters.AddWithValue("lost",lost);if(await bad.ExecuteScalarAsync(ct) is true)throw Fail("mfa_loss_factor_or_policy_invalid");}
+        var counts=new long[4];
