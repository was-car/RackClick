<Project Sdk="Microsoft.NET.Sdk">

  <!-- Comprobador de lectura L2l02. Sin paquetes NuGet: sólo BCL y las DLL de la publicación aprobada 03 (RackClickServerDir). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>RackClick.MfaServiceReadProbe</AssemblyName>
    <RootNamespace>RackClick.MfaServiceReadProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RackClick.Server">
      <HintPath>$(RackClickServerDir)\RackClick.Server.dll</HintPath>
    </Reference>
    <Reference Include="RackClick.Domain">
      <HintPath>$(RackClickServerDir)\RackClick.Domain.dll</HintPath>
    </Reference>
    <Reference Include="Npgsql">
      <HintPath>$(RackClickServerDir)\Npgsql.dll</HintPath>
    </Reference>
    <Reference Include="Otp.NET">
      <HintPath>$(RackClickServerDir)\Otp.NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="RequireApprovedServerDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RackClickServerDir)' == ''"
           Text="Falta RackClickServerDir: carpeta de la publicación aprobada 03 (RackClick.Server.dll)." />
    <Error Condition="!Exists('$(RackClickServerDir)\RackClick.Server.dll')"
           Text="No existe RackClick.Server.dll en RackClickServerDir." />
  </Target>

</Project>
