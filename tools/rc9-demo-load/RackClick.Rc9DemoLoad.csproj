<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Npgsql"><HintPath>$(RackClickServerDir)/Npgsql.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequirePinnedPublication" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RackClickServerDir)' == '' Or !Exists('$(RackClickServerDir)/Npgsql.dll')" Text="RackClickServerDir must identify the verified existing publication." />
  </Target>
</Project>
