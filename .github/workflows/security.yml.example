# BORRADOR LOCAL: no publicar/activar sin la decisión de repositorio/CI de Wascar.
# Manual solamente; no push/pull_request, despliegue, subida de informes o secretos.
name: Security (manual draft)

on:
  workflow_dispatch:
    inputs:
      authorized_ci:
        description: "Existe autorización para ejecutar este código en este repositorio privado"
        type: boolean
        required: true
        default: false
      include_postgresql:
        description: "Ejecutar integración en Docker del runner con PostgreSQL 17.11"
        type: boolean
        required: true
        default: false

permissions:
  contents: read

jobs:
  source-and-build:
    if: ${{ inputs.authorized_ci }}
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      DOTNET_CLI_TELEMETRY_OPTOUT: '1'
      DOTNET_NOLOGO: '1'
      DOTNET_GENERATE_ASPNET_CERTIFICATE: 'false'
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6.0.0
        with:
          python-version: '3.12.10'
      - name: Instalar Gitleaks oficial con versión y SHA256 fijados
        run: python -B tools/security/secret_scan.py install
      - name: Pruebas positivas y negativas del scanner y hook
        run: python -B -m unittest discover -s tools/tests/security -v
      - name: Todos los refs Git y archivos tracked actuales
        run: python -B tools/security/secret_scan.py scan --mode all
      - uses: actions/setup-dotnet@d4c94342e560b34958eacfc5d055d21461ed1c5d # v5.0.0
        with:
          global-json-file: development/server/global.json
      - name: Comprobar SDK fijado, restaurar locks y compilar
        working-directory: development/server
        shell: pwsh
        run: |
          $pin = Get-Content -LiteralPath global.json -Raw | ConvertFrom-Json
          $version = & dotnet --version
          if ($LASTEXITCODE -ne 0 -or $version.Trim() -cne $pin.sdk.version -or $pin.sdk.rollForward -cne 'disable') { throw 'SDK pin mismatch' }
          & dotnet restore RackClick.sln --locked-mode --configfile ../../NuGet.Config -p:NuGetAudit=true -p:NuGetAuditMode=all
          if ($LASTEXITCODE -ne 0) { throw 'Locked restore or audit failed' }
          & dotnet restore tests/RackClick.Quality.Tests/RackClick.Quality.Tests.csproj --locked-mode --configfile ../../NuGet.Config -p:NuGetAudit=true -p:NuGetAuditMode=all
          if ($LASTEXITCODE -ne 0) { throw 'Quality project locked restore or audit failed' }
          & dotnet build RackClick.sln --no-restore -c Release
          if ($LASTEXITCODE -ne 0) { throw 'Build failed' }
      - name: Auditar paquetes directos y transitivos sin publicar informe
        working-directory: development/server
        shell: pwsh
        run: |
          $reports = Join-Path $env:GITHUB_WORKSPACE '.local/security/PRIVADOS.local/ci'
          New-Item -ItemType Directory -Path $reports -Force | Out-Null
          $count = 0
          $targets = @('RackClick.sln', 'tests/RackClick.Quality.Tests/RackClick.Quality.Tests.csproj')
          for ($index = 0; $index -lt $targets.Count; $index++) {
            $errorFile = Join-Path $reports ('nuget-' + $index + '.stderr.txt')
            $auditText = & dotnet package list $targets[$index] --vulnerable --include-transitive --format json --output-version 1 --no-restore 2> $errorFile
            if ($LASTEXITCODE -ne 0) { throw 'Dependency audit incomplete' }
            $auditJson = $auditText -join [Environment]::NewLine
            [IO.File]::WriteAllText((Join-Path $reports ('nuget-' + $index + '.json')), $auditJson)
            $audit = $auditJson | ConvertFrom-Json
            if ($audit.version -ne 1 -or $null -eq $audit.projects -or @($audit.projects).Count -lt 1 -or $audit.problems) { throw 'Dependency audit schema/incomplete' }
            if ((Get-Content -LiteralPath $errorFile -Raw) -match 'NU1900|NU1905|error|failed') { throw 'Dependency audit source failed' }
            foreach ($project in $audit.projects) {
              if ($null -eq $project -or $project.problems) { throw 'Dependency project audit incomplete' }
              foreach ($framework in $project.frameworks) {
                foreach ($package in @($framework.topLevelPackages) + @($framework.transitivePackages)) {
                  if ($null -ne $package -and $package.vulnerabilities) { $count += @($package.vulnerabilities).Count }
                }
              }
            }
          }
          Write-Output ('Known package vulnerabilities: ' + $count)
          if ($count -gt 0) { throw 'Known vulnerable dependencies require review' }
      - name: Ejecutar arnés legado de dominio (es consola, no dotnet test)
        working-directory: development/server
        run: dotnet tests/RackClick.Domain.Tests/bin/Release/net10.0/RackClick.Domain.Tests.dll
      - name: xUnit HTTP sin contenedores (proyecto explícito fuera de la solución)
        working-directory: development/server
        run: dotnet test tests/RackClick.Quality.Tests/RackClick.Quality.Tests.csproj --no-restore -c Release --filter 'RequiresDocker!=true'

  isolated-postgresql:
    needs: source-and-build
    if: ${{ inputs.authorized_ci && inputs.include_postgresql }}
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      RACKCLICK_REQUIRE_DOCKER: '1'
      DOTNET_CLI_TELEMETRY_OPTOUT: '1'
      DOTNET_NOLOGO: '1'
    steps:
      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0
        with:
          persist-credentials: false
      - uses: actions/setup-dotnet@d4c94342e560b34958eacfc5d055d21461ed1c5d # v5.0.0
        with:
          global-json-file: development/server/global.json
      - name: Restaurar proyecto de pruebas aislado sin cambiar locks
        working-directory: development/server
        run: dotnet restore tests/RackClick.Quality.Tests/RackClick.Quality.Tests.csproj --locked-mode --configfile ../../NuGet.Config
      - name: xUnit y PostgreSQL desechable del runner; Docker obligatorio
        working-directory: development/server
        run: dotnet test tests/RackClick.Quality.Tests/RackClick.Quality.Tests.csproj --no-restore -c Release
